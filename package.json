{
  "name": "aa-shinaka-digital-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Tailwind CSS build tooling for AA Shinaka Digital Business Platform.",
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/app.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./static/src/app.css -o ./static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
