# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Django
*.log
db.sqlite3
/staticfiles/
/media/

# Tailwind build output (generated by `npm run build:css`)
# The Tailwind source lives in assets/css/app.css and IS tracked.
/static/css/app.css

# Node
node_modules/

# Environment / secrets — never commit
.env
.env.*
!.env.example
!deploy/.env.production.example
!deploy/.env.staging.example
!deploy/.env.local.example

# Deployment state — rendered per deployment, never committed
/deploy/nginx/certs/
/deploy/nginx/certbot-www/
/deploy/nginx/conf.d/default.conf
/backups/

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
