# Line-ending policy.
#
# The deployment target is Linux, and a shell script with CRLF line endings
# fails there with `bad interpreter: /usr/bin/env bash^M`. Windows developers
# run with `core.autocrlf=true`, so the repository index is already normalised
# to LF; this file makes the guarantee explicit and independent of any single
# machine's Git configuration.

# Normalise text files on commit; keep binary files untouched.
* text=auto

# Anything executed, mounted or parsed on the host must always be LF.
*.sh       text eol=lf
*.bash     text eol=lf
Dockerfile text eol=lf
*.conf     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.env      text eol=lf
*.example  text eol=lf

# Binary assets must never be line-ending transformed.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.xlsx  binary
