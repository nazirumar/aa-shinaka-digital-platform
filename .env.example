# ---------------------------------------------------------------------------
# AA Shinaka Digital Business Platform — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Database (PostgreSQL) -------------------------------------------------
# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://aa_shinaka:aa_shinaka_dev_pw@127.0.0.1:5432/aa_shinaka
DB_CONN_MAX_AGE=60

# --- Celery / Redis --------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Set to False when no worker/beat runs (e.g. Render Free): .delay() executes
# inline instead of queueing work that nothing will consume.
CELERY_ENABLED=True

# --- Cache (rate limiting) -------------------------------------------------
# Development default is in-process memory; production should use Redis.
CACHE_URL=locmemcache://
# CACHE_URL=redis://127.0.0.1:6379/2

# --- Email (verification, password reset) ----------------------------------
# Dev uses the console backend; production uses SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=AA Shinaka <no-reply@aashinaka.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_VERIFICATION_TIMEOUT=172800
PASSWORD_RESET_TIMEOUT=86400
# Managed hosts that block outbound SMTP (Render Free) can deliver over HTTPS:
# EMAIL_BACKEND=config.email_backends.ResendEmailBackend
# RESEND_API_KEY=
# RESEND_API_URL=https://api.resend.com/emails
# RESEND_TIMEOUT=10

# --- Periodic jobs fallback ------------------------------------------------
# Enables POST /internal/scheduled-jobs/ for an external scheduler when Celery
# beat is not deployed. >= 32 chars in production; empty disables the endpoint.
# SCHEDULED_JOBS_TOKEN=
# SCHEDULED_JOBS_MIN_INTERVAL=60

# --- One-shot owner bootstrap (hosts with no shell, e.g. Render Free) -------
# Enables POST /internal/bootstrap-owner/ (header X-Bootstrap-Token) to create
# the first superuser. >= 32 chars in production; empty disables the endpoint,
# and it self-disables once any superuser exists. Remove after first use.
# BOOTSTRAP_OWNER_TOKEN=
# BOOTSTRAP_OWNER_EMAIL=owner@example.com

# --- Uploaded media --------------------------------------------------------
# Where user uploads live. On an ephemeral host set this to a mounted disk
# path; the default is the repository's ./media directory.
# DJANGO_MEDIA_ROOT=/var/lib/aa-shinaka/media

# --- Security / sessions ---------------------------------------------------
SESSION_COOKIE_AGE=1209600
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW=300
FORM_RATE_LIMIT_ATTEMPTS=20
FORM_RATE_LIMIT_WINDOW=3600

# --- Multi-factor authentication (privileged staff, Phase 13) ---------------
# How long a password-verified-but-MFA-pending login may stay parked.
MFA_CHALLENGE_TIMEOUT=300
# TOTP attempts per window before the challenge is rate-limited (HTTP 429).
MFA_RATE_LIMIT_ATTEMPTS=5
MFA_RATE_LIMIT_WINDOW=300
# Optional dedicated key for encrypting stored TOTP secrets; blank falls back
# to DJANGO_SECRET_KEY. Rotating it invalidates existing enrolments.
MFA_SECRET_KEY=

# --- Upload security & malware scanning (Phase 13) --------------------------
# enforce: reject unscannable uploads and block unscanned/errored downloads
# (fail closed). log: audit scanner failures but let the file through; positively
# identified malware is rejected and blocked in BOTH modes.
UPLOAD_SCAN_ENFORCEMENT=enforce
# Optional ClamAV clamd endpoint (prefer a unix socket in production). With both
# blank, only the built-in EICAR/executable-signature scanner runs.
CLAMAV_SOCKET=
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=20
# Hard cap on how much of one upload is read into memory for scanning (bytes).
UPLOAD_SCAN_MAX_BYTES=33554432

# --- Commerce business rules ------------------------------------------------
# How long an unpaid order's stock reservation is held before it expires.
ORDER_RESERVATION_TTL_HOURS=48
# Tax rate applied at checkout; 0.00 until finance configures it (ASSUMPTION-04).
ORDER_TAX_RATE=0.00

# --- Paystack (Phase 6: payments, refunds) ---------------------------------
# Enabled only when a (test-mode) secret key is set. CI/sandbox uses sk_test_.
PAYSTACK_ENABLED=False
# Live launch gate: keep False. A sk_live_ key is refused until this is True.
PAYSTACK_LIVE_MODE=False
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Set only if a separate webhook secret is configured in the Paystack dashboard;
# otherwise webhooks are verified with PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=NGN
PAYSTACK_TIMEOUT=20
# Optional absolute post-checkout redirect; leave blank to derive from the request.
PAYSTACK_CALLBACK_URL=

# --- Notifications & support (Phase 10) -------------------------------------
# In-app notifications are always available. Email delivery reuses the mail
# backend above; set NOTIFICATION_EMAIL_ENABLED=False to make the unified
# notification system in-app only. Absolute site URL used to build the links
# inside notification emails (blank derives nothing — links stay relative).
NOTIFICATION_EMAIL_ENABLED=True
NOTIFICATION_MAX_ATTEMPTS=3
SITE_URL=
# SMS/WhatsApp are INERT until an approved provider is configured here AND the
# customer opts in. Never hardcode provider credentials. Leaving these blank is
# the supported default; unconfigured channels are recorded as skipped.
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_API_KEY=

# --- Analytics & reporting (Phase 11) --------------------------------------
# Reporting currency (display only). Money is ALWAYS computed per currency and is
# never summed across currencies unless ANALYTICS_EXCHANGE_RATES below is set.
ANALYTICS_BASE_CURRENCY=NGN
# Optional JSON map of exchange rates (e.g. {"USD": "1500.00"}). Leave blank to
# keep every report strictly per-currency — the platform never invents a rate.
ANALYTICS_EXCHANGE_RATES={}
# Generated report files are deleted after this many days (retention).
ANALYTICS_REPORT_RETENTION_DAYS=30
# Report generation runs synchronously by default (deterministic without a
# Celery worker). Set True to queue generation and rely on Celery.
ANALYTICS_EXPORT_ASYNC=False

# --- Production-only overrides (ignored in dev) ----------------------------
# Used only by config.settings.prod. See deploy/.env.production.example for the
# complete production template and docs/PRODUCTION_RUNBOOK.md.
CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
# Trust the proxy's X-Forwarded-Proto/Host (only behind a TLS-terminating proxy).
USE_X_FORWARDED_HOST=True
# HSTS. Preload stays off until every subdomain is permanently HTTPS (irreversible).
DJANGO_SECURE_HSTS_SECONDS=2592000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
# Database hardening (prod): statement-atomic requests and TLS to PostgreSQL.
DB_ATOMIC_REQUESTS=True
DB_SSLMODE_REQUIRE=True
# Static asset cache lifetime (seconds) served by WhiteNoise.
WHITENOISE_MAX_AGE=31536000
# Operations mailbox for error emails and the From: of Django's SERVER_EMAIL.
OPS_EMAIL=ops@example.com
SERVER_EMAIL=ops@example.com
DJANGO_LOG_LEVEL=INFO
