DOMAIN=aashinaka.com

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=aashinaka.com,www.aashinaka.com
CSRF_TRUSTED_ORIGINS=https://aashinaka.com,https://www.aashinaka.com
SITE_URL=https://aashinaka.com

POSTGRES_DB=aa_shinaka
POSTGRES_USER=aa_shinaka
POSTGRES_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgres://aa_shinaka:YOUR_STRONG_DATABASE_PASSWORD@db:5432/aa_shinaka

REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD
CACHE_URL=redis://:YOUR_STRONG_REDIS_PASSWORD@redis:6379/2
CELERY_BROKER_URL=redis://:YOUR_STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:YOUR_STRONG_REDIS_PASSWORD@redis:6379/1

DB_SSLMODE_REQUIRE=False

GUNICORN_WORKERS=2
CELERY_CONCURRENCY=1

PAYSTACK_ENABLED=False
PAYSTACK_LIVE_MODE=False
