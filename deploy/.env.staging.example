# ---------------------------------------------------------------------------
# AA Shinaka Digital Business Platform — STAGING environment template.
# Copy to deploy/.env.staging and fill in real values. NEVER commit it.
#
# Staging is a production-shaped environment used to verify a release before the
# owner approves a controlled production launch. It MUST be isolated from
# production: a separate database, Redis instance, media volume, hostname and
# Paystack TEST keys. Live payments are refused at import time
# (config/settings/staging.py).
# ---------------------------------------------------------------------------

# --- Host / domain ----------------------------------------------------------
# Staging normally runs on 8080/8443 (see docker-compose.staging.yml) so it can
# share a host with production without a port clash.
DOMAIN=staging.EXAMPLE_DOMAIN
HTTP_PORT=8080
HTTPS_PORT=8443

# Which env file the containers load. Compose APPENDS `env_file` entries from
# override files, so staging selects its own file here instead of adding an
# `env_file:` to the overlay — production secrets are never read on staging.
APP_ENV_FILE=.env.staging

# --- Django core -----------------------------------------------------------
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=staging.EXAMPLE_DOMAIN
CSRF_TRUSTED_ORIGINS=https://staging.EXAMPLE_DOMAIN
SITE_URL=https://staging.EXAMPLE_DOMAIN

# --- Database (PostgreSQL) — a DIFFERENT database from production ----------
DATABASE_URL=postgres://aa_shinaka_staging:CHANGE_ME@db:5432/aa_shinaka_staging
POSTGRES_DB=aa_shinaka_staging
POSTGRES_USER=aa_shinaka_staging
POSTGRES_PASSWORD=CHANGE_ME
DB_CONN_MAX_AGE=600
DB_ATOMIC_REQUESTS=True
DB_SSLMODE_REQUIRE=False

# --- Cache / Celery / Redis — a DIFFERENT Redis logical DB / instance ------
# REDIS_PASSWORD must be URL-safe ([A-Za-z0-9]) because it is embedded below.
REDIS_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_STRING
CACHE_URL=redis://:CHANGE_ME_USE_A_LONG_RANDOM_STRING@redis:6379/2
CELERY_BROKER_URL=redis://:CHANGE_ME_USE_A_LONG_RANDOM_STRING@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_USE_A_LONG_RANDOM_STRING@redis:6379/1
CELERY_CONCURRENCY=2

# --- Gunicorn ---------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# --- Email (a real mailbox or a staging capture inbox) ---------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=AA Shinaka Staging <no-reply@staging.EXAMPLE_DOMAIN>
SERVER_EMAIL=no-reply@staging.EXAMPLE_DOMAIN
OPS_EMAIL=ops@staging.EXAMPLE_DOMAIN
EMAIL_HOST=smtp.EXAMPLE_DOMAIN
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Security / sessions ---------------------------------------------------
SESSION_COOKIE_AGE=1209600
DJANGO_SECURE_SSL_REDIRECT=True
# Short HSTS on staging so a broken TLS setup can be rolled back quickly.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_HOST=True
WHITENOISE_MAX_AGE=31536000
DJANGO_LOG_LEVEL=INFO

# --- Rate limiting (looser on staging for load tests) ----------------------
LOGIN_RATE_LIMIT_ATTEMPTS=50
LOGIN_RATE_LIMIT_WINDOW=300
FORM_RATE_LIMIT_ATTEMPTS=100
FORM_RATE_LIMIT_WINDOW=3600

# --- MFA -------------------------------------------------------------------
MFA_CHALLENGE_TIMEOUT=300
MFA_RATE_LIMIT_ATTEMPTS=5
MFA_RATE_LIMIT_WINDOW=300
MFA_SECRET_KEY=

# --- Upload security & malware scanning ------------------------------------
UPLOAD_SCAN_ENFORCEMENT=enforce
CLAMAV_SOCKET=
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=20
UPLOAD_SCAN_MAX_BYTES=33554432

# --- Backups (same tooling as production; a separate directory) ------------
BACKUP_DIR=/var/backups/aa-shinaka-staging
BACKUP_RETENTION_DAYS=14
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=
BACKUP_RCLONE_REMOTE=
DISK_USAGE_THRESHOLD=85

# --- Commerce --------------------------------------------------------------
ORDER_RESERVATION_TTL_HOURS=48
ORDER_TAX_RATE=0.00

# --- Paystack (TEST MODE ONLY — live keys are refused on staging) ----------
PAYSTACK_ENABLED=True
PAYSTACK_LIVE_MODE=False
PAYSTACK_PUBLIC_KEY=pk_test_
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_WEBHOOK_SECRET=

# --- Notifications ---------------------------------------------------------
NOTIFICATION_EMAIL_ENABLED=True
NOTIFICATION_MAX_ATTEMPTS=3

# --- Analytics -------------------------------------------------------------
ANALYTICS_BASE_CURRENCY=NGN
ANALYTICS_REPORT_RETENTION_DAYS=30
ANALYTICS_EXPORT_ASYNC=False
