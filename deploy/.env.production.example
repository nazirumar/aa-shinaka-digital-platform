# ---------------------------------------------------------------------------
# AA Shinaka Digital Business Platform — PRODUCTION environment template.
#
#   cp deploy/.env.production.example deploy/.env.production   (then fill in)
#   ./deploy/scripts/validate_env.sh deploy/.env.production
#
# Used by deploy/docker-compose.yml. NEVER commit deploy/.env.production.
# Values marked EXAMPLE_DOMAIN are placeholders that validation rejects until
# the owner supplies the real domain.
# ---------------------------------------------------------------------------

# --- Host / domain ----------------------------------------------------------
# Supplied by the owner. Public DNS is never modified by these scripts.
DOMAIN=EXAMPLE_DOMAIN
HTTP_PORT=80
HTTPS_PORT=443

# Which env file the containers load. Compose APPENDS `env_file` entries from
# override files, so this indirection is what keeps staging and production from
# reading each other's secrets. Leave as-is for production.
APP_ENV_FILE=.env.production

# --- Django core -----------------------------------------------------------
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=EXAMPLE_DOMAIN,www.EXAMPLE_DOMAIN
CSRF_TRUSTED_ORIGINS=https://EXAMPLE_DOMAIN,https://www.EXAMPLE_DOMAIN
SITE_URL=https://EXAMPLE_DOMAIN

# --- Database (PostgreSQL, inside the Compose network) ----------------------
# POSTGRES_* initialise the container; DATABASE_URL is what Django uses.
# They MUST describe the same database, and the two passwords MUST match
# exactly (validate_env.sh checks this).
POSTGRES_DB=aa_shinaka
POSTGRES_USER=aa_shinaka
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_STRING
DATABASE_URL=postgres://aa_shinaka:CHANGE_ME_USE_A_LONG_RANDOM_STRING@db:5432/aa_shinaka
DB_CONN_MAX_AGE=600
DB_ATOMIC_REQUESTS=True
# PostgreSQL runs on the internal `backend` Docker network with no TLS on the
# wire and no published port. Keep this False for the Compose deployment; set
# True only when connecting to a managed/remote PostgreSQL that requires SSL.
DB_SSLMODE_REQUIRE=False

# --- Cache / Celery / Redis ------------------------------------------------
# REDIS_PASSWORD must be URL-safe ([A-Za-z0-9]) because it is embedded in the
# Redis URLs below. Generate with: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48
REDIS_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_STRING
CACHE_URL=redis://:CHANGE_ME_USE_A_LONG_RANDOM_STRING@redis:6379/2
CELERY_BROKER_URL=redis://:CHANGE_ME_USE_A_LONG_RANDOM_STRING@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_USE_A_LONG_RANDOM_STRING@redis:6379/1
CELERY_CONCURRENCY=4

# --- Gunicorn ---------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# --- Email (real delivery; console/locmem backends are rejected) -----------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=AA Shinaka <no-reply@EXAMPLE_DOMAIN>
SERVER_EMAIL=no-reply@EXAMPLE_DOMAIN
OPS_EMAIL=ops@EXAMPLE_DOMAIN
EMAIL_HOST=smtp.EXAMPLE_DOMAIN
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Security / sessions ---------------------------------------------------
SESSION_COOKIE_AGE=1209600
DJANGO_SECURE_SSL_REDIRECT=True
# Start at 30 days; raise and enable preload only after HTTPS is verified
# end-to-end (preload is hard to undo).
DJANGO_SECURE_HSTS_SECONDS=2592000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_HOST=True
WHITENOISE_MAX_AGE=31536000
DJANGO_LOG_LEVEL=INFO

# --- Rate limiting ---------------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW=300
FORM_RATE_LIMIT_ATTEMPTS=20
FORM_RATE_LIMIT_WINDOW=3600

# --- Multi-factor authentication (privileged staff) -------------------------
MFA_CHALLENGE_TIMEOUT=300
MFA_RATE_LIMIT_ATTEMPTS=5
MFA_RATE_LIMIT_WINDOW=300
# Optional dedicated key for encrypting stored TOTP secrets (blank = SECRET_KEY).
MFA_SECRET_KEY=

# --- Upload security & malware scanning ------------------------------------
# Keep `enforce` in production. Provide a clamd socket where ClamAV runs, e.g.
# CLAMAV_SOCKET=/var/run/clamav/clamd.ctl (shared volume in docker-compose).
# Enable ClamAV with: docker compose --profile scanning up -d
UPLOAD_SCAN_ENFORCEMENT=enforce
CLAMAV_SOCKET=
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=20
UPLOAD_SCAN_MAX_BYTES=33554432

# --- Backups ---------------------------------------------------------------
# Backups run on the HOST (deploy/scripts/backup_docker.sh) so that encryption
# keys and the off-server copy never live inside a container. See
# docs/HOSTINGER_VPS_DEPLOYMENT.md § Backup and recovery.
BACKUP_DIR=/var/backups/aa-shinaka
BACKUP_RETENTION_DAYS=30
# Age is preferred. Generate a recipient with: age-keygen -o backup.key
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=
# An rclone remote, e.g. b2:aa-shinaka-backups or s3:aa-shinaka-backups.
BACKUP_RCLONE_REMOTE=
# Daily disk-space alert threshold (percent used).
DISK_USAGE_THRESHOLD=85

# --- Commerce --------------------------------------------------------------
ORDER_RESERVATION_TTL_HOURS=48
ORDER_TAX_RATE=0.00

# --- Paystack (TEST keys until launch is explicitly approved) --------------
PAYSTACK_ENABLED=False
# Live launch gate: keep False. A sk_live_ key is refused unless this is True.
PAYSTACK_LIVE_MODE=False
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Notifications ---------------------------------------------------------
NOTIFICATION_EMAIL_ENABLED=True
NOTIFICATION_MAX_ATTEMPTS=3

# --- Analytics -------------------------------------------------------------
ANALYTICS_BASE_CURRENCY=NGN
ANALYTICS_REPORT_RETENTION_DAYS=30
ANALYTICS_EXPORT_ASYNC=False
