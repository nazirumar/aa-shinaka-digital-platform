# ---------------------------------------------------------------------------
# AA Shinaka Digital Business Platform — LOCAL TEST environment template.
#
#   cp deploy/.env.local.example deploy/.env.local
#   ./deploy/scripts/render_nginx.sh --local
#   docker compose --env-file deploy/.env.local \
#     -f deploy/docker-compose.yml -f deploy/docker-compose.local.yml up -d --build
#
# Runs the WHOLE production-shaped stack (nginx, Gunicorn, PostgreSQL, Redis,
# Celery worker + beat and a Mailpit capture inbox) on a development machine.
# It is selected by DJANGO_SETTINGS_MODULE=config.settings.local (see
# deploy/docker-compose.local.yml), which is the production configuration with
# only the HTTPS requirement relaxed for plain HTTP on localhost.
#
# THIS FILE CONTAINS NO REAL SECRETS AND IS NOT FOR ANY DEPLOYED ENVIRONMENT.
# The values below are obvious throwaway local-development placeholders. The
# committed production/staging templates (`deploy/.env.production.example`,
# `deploy/.env.staging.example`) are the ones an operator fills in.
# ---------------------------------------------------------------------------

# --- Host / domain ----------------------------------------------------------
# Local HTTP only. 8443 is published by the base file but nothing listens on it
# locally (deploy/nginx/local.conf is HTTP-only) — it is left mapped so the two
# Compose files stay identical in shape.
DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# Which env file the containers load (Compose appends `env_file` entries from
# override files, so this indirection keeps local/staging/production separate).
APP_ENV_FILE=.env.local

# --- Django core -----------------------------------------------------------
# A throwaway local-only value: this file is NOT used on any deployed host.
DJANGO_SECRET_KEY=local-only-throwaway-key-not-used-anywhere-0123456789-abcdefghijklmnop
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Left UNSET on purpose: config.settings.local supplies the http:// local
# origin. prod.py only accepts https:// origins, and an empty value would parse
# as [''] and abort startup, so do not add the variable here.
# CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8080

# --- Database (PostgreSQL) — a separate local database ---------------------
POSTGRES_DB=aa_shinaka_local
POSTGRES_USER=aa_shinaka_local
POSTGRES_PASSWORD=aa_shinaka_local_pw
DATABASE_URL=postgres://aa_shinaka_local:aa_shinaka_local_pw@db:5432/aa_shinaka_local
DB_CONN_MAX_AGE=60
DB_ATOMIC_REQUESTS=True
DB_SSLMODE_REQUIRE=False

# --- Cache / Celery / Redis ------------------------------------------------
# REDIS_PASSWORD must be URL-safe ([A-Za-z0-9]) because it is embedded below.
REDIS_PASSWORD=aa_shinaka_local_redis
CACHE_URL=redis://:aa_shinaka_local_redis@redis:6379/2
CELERY_BROKER_URL=redis://:aa_shinaka_local_redis@redis:6379/0
CELERY_RESULT_BACKEND=redis://:aa_shinaka_local_redis@redis:6379/1
CELERY_CONCURRENCY=2

# --- Gunicorn ---------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# --- Email (captured locally by Mailpit — never leaves the machine) --------
# Mailpit's web UI is on http://localhost:8025. SMTP delivery is real, so the
# "send only when the backend confirms delivery" logic is genuinely exercised.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=AA Shinaka Local <no-reply@localhost>
SERVER_EMAIL=no-reply@localhost
OPS_EMAIL=ops@localhost
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Security / sessions ---------------------------------------------------
# Local HTTPS controls live in config/settings/local.py (SSL redirect off,
# HSTS 0, non-Secure cookies) so plain-HTTP login works on localhost.
SESSION_COOKIE_AGE=1209600
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_HOST=True
WHITENOISE_MAX_AGE=0
DJANGO_LOG_LEVEL=INFO

# --- Rate limiting (looser locally so repeated testing is not throttled) ---
LOGIN_RATE_LIMIT_ATTEMPTS=50
LOGIN_RATE_LIMIT_WINDOW=300
FORM_RATE_LIMIT_ATTEMPTS=100
FORM_RATE_LIMIT_WINDOW=3600

# --- MFA -------------------------------------------------------------------
MFA_CHALLENGE_TIMEOUT=300
MFA_RATE_LIMIT_ATTEMPTS=5
MFA_RATE_LIMIT_WINDOW=300
MFA_SECRET_KEY=

# --- Upload security -------------------------------------------------------
# `log` locally tolerates a missing ClamAV container (see config/settings/local.py);
# production and staging keep `enforce`.
UPLOAD_SCAN_ENFORCEMENT=log
CLAMAV_SOCKET=
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=20
UPLOAD_SCAN_MAX_BYTES=33554432

# --- Backups (not scheduled locally; the tooling is the same as production) -
BACKUP_DIR=/var/backups/aa-shinaka-local
BACKUP_RETENTION_DAYS=3
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=
BACKUP_RCLONE_REMOTE=
DISK_USAGE_THRESHOLD=95

# --- Commerce --------------------------------------------------------------
ORDER_RESERVATION_TTL_HOURS=48
ORDER_TAX_RATE=0.00

# --- Paystack (DISABLED locally; test keys only if you supply them) --------
PAYSTACK_ENABLED=False
PAYSTACK_LIVE_MODE=False
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Notifications ---------------------------------------------------------
NOTIFICATION_EMAIL_ENABLED=True
NOTIFICATION_MAX_ATTEMPTS=3

# --- Analytics -------------------------------------------------------------
ANALYTICS_BASE_CURRENCY=NGN
ANALYTICS_REPORT_RETENTION_DAYS=30
ANALYTICS_EXPORT_ASYNC=False
