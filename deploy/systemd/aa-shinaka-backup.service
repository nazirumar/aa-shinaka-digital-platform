# /etc/systemd/system/aa-shinaka-backup.service
[Unit]
Description=AA Shinaka — PostgreSQL backup
After=postgresql.service

[Service]
Type=oneshot
User=aashinaka
EnvironmentFile=/etc/aa-shinaka/aa-shinaka.env
EnvironmentFile=-/etc/aa-shinaka/backup.env
ExecStart=/srv/aa-shinaka/deploy/scripts/backup.sh
